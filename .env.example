# ==============================================================================
# SENTINEL-X — Environment Configuration Example
# ==============================================================================

# Application & API
APP_NAME=SENTINEL-X
ENV=production
DEBUG=False
SECRET_KEY=sentinel_x_super_secret_jwt_encryption_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQLite default / PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/safety_system.db

# Storage & Model Paths
MODEL_PATH=ml/weights/yolov8n.pt
PPE_MODEL_PATH=ml/weights/yolov8n-ppe-v2.1.pt
CLS_MODEL_PATH=ml/weights/yolov8n-cls.pt
BYTETRACK_CONFIG=ml/configs/bytetrack.yaml
EMBEDDINGS_DIR=data/embeddings
WORKER_FACES_DIR=data/worker_faces
EVIDENCE_DIR=data/evidence

# Biometric & Computer Vision Calibration
CONFIDENCE_THRESHOLD=0.98
DETECTION_CONFIDENCE=0.35
PPE_CONFIDENCE=0.45
TEMPORAL_CONSENSUS_FRAMES=5
PRESENTATION_ATTACK_DETECTION=True

# Default Geolocation & Weather Monitoring (Open-Meteo)
SITE_NAME=Industrial Facility Alpha (Chennai Works)
SITE_LATITUDE=13.0827
SITE_LONGITUDE=80.2707
WEATHER_CACHE_TTL_SECONDS=300
ALLOW_BROWSER_LOCATION=True

# Hardware & Video Capture
DEFAULT_CAMERA_INDEX=0
DEFAULT_FRAME_WIDTH=640
DEFAULT_FRAME_HEIGHT=480
FRAME_SKIP=2

# Default Seed Credentials
# Admin: admin / admin123 (Role: ADMIN)
# Manager 1: kumar / kumar123 (Role: PROJECT_MANAGER)
# Manager 2: prakash / prakash123 (Role: PROJECT_MANAGER)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
